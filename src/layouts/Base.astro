---
import "../styles/global.css";

interface Props {
  titulo: string;
  descripcion: string;
}

const { titulo, descripcion } = Astro.props;
---

<!doctype html>
<html lang="es" data-theme="oscuro">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={descripcion} />
    <meta name="generator" content={Astro.generator} />
    <title>{titulo}</title>
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>📷</text></svg>"
    />
    <script>
      document.documentElement.dataset.theme =
        localStorage.getItem("kultura-tema") === "claro" ? "claro" : "oscuro";
    </script>
  </head>
  <body>
    <header class="encabezado">
      <div class="encabezado-inner">
        <a class="marca" href="/">
          <img class="marca-logo" src="/images/logo.png" alt="KuLtura.cl" width="800" height="800" />
        </a>
        <button
          id="tema-btn"
          class="tema-switch"
          type="button"
          role="switch"
          aria-checked="false"
          aria-label="Tema oscuro"
        >
          <span aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          </span>
          <span aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
          </span>
          <span class="tema-knob" aria-hidden="true"></span>
        </button>
      </div>
    </header>

    <slot />

    <footer class="pie">
      <p>© 2026 KuLtura.cl — cultura en imágenes y palabras.</p>
    </footer>

    <script>
      const btn = document.querySelector("#tema-btn");
      const html = document.documentElement;
      const actualizar = () => {
        const oscuro = html.dataset.theme === "oscuro";
        btn.setAttribute("aria-checked", String(oscuro));
        btn.setAttribute("aria-label", oscuro ? "Tema oscuro" : "Tema claro");
      };
      actualizar();
      btn.addEventListener("click", () => {
        const claro = html.dataset.theme === "claro";
        html.dataset.theme = claro ? "oscuro" : "claro";
        localStorage.setItem("kultura-tema", claro ? "oscuro" : "claro");
        actualizar();
      });
    </script>
  </body>
</html>
