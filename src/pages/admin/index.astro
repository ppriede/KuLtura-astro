---
// Página de administración de Decap CMS
// Solo disponible en desarrollo local (npm run dev).
// En producción (sitio deployado) muestra mensaje informativo.
const esLocal = import.meta.env.DEV;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>KuLtura — Admin</title>
  {esLocal && (
    <link rel="cms-config-url" type="text/yaml" href="/admin/config.yml" />
  )}
</head>
<body>
  {esLocal ? (
    <>
      <script is:inline src="https://unpkg.com/decap-cms@^3.0.0/dist/decap-cms.js"></script>
      <script is:inline>
        CMS.registerEditorComponent({
          id: "youtube",
          label: "YouTube",
          fields: [{ name: "url", label: "URL de YouTube", widget: "string" }],
          pattern: /^@youtube\s+(.+)$/,
          fromBlock(match) {
            const rest = match[1].trim();
            return { url: rest.match(/\((.*?)\)/)?.[1] ?? rest };
          },
          toBlock(obj) {
            return `@youtube ${obj.url.trim()}`;
          },
          toPreview(obj) {
            const id = obj.url.match(/(?:v=|youtu\.be\/|shorts\/|embed\/|live\/)([\w-]{11})/)?.[1];
            return id
              ? `<img src="https://i.ytimg.com/vi/${id}/hqdefault.jpg" alt="Video de YouTube" style="max-width: 100%" />`
              : "<p>URL de YouTube no reconocida</p>";
          },
        });
      </script>
    </>
  ) : (
    <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:100vh;text-align:center;padding:2rem;font-family:system-ui,sans-serif;background:#141312;color:#ece7df;">
      <h1 style="font-family:Georgia,serif;font-size:2rem;margin-bottom:1rem;">KuLtura.cl</h1>
      <p style="color:#9b958c;font-size:1.125rem;max-width:400px;">
        El panel de administración solo está disponible en el entorno de desarrollo local o mediante Tailscale.
      </p>
      <div style="margin-top:2rem;background:#1d1c1a;border:1px solid #322f2b;border-radius:8px;padding:1.5rem;max-width:500px;text-align:left;">
        <p style="margin:0 0 0.5rem;color:#ece7df;font-weight:600;">Para editar contenido:</p>
        <code style="display:block;background:#141312;padding:0.75rem 1rem;border-radius:4px;font-size:0.875rem;color:#c96a5e;margin-bottom:0.5rem;">
          npx decap-server
        </code>
        <code style="display:block;background:#141312;padding:0.75rem 1rem;border-radius:4px;font-size:0.875rem;color:#c96a5e;margin-bottom:0.75rem;">
          npm run dev -- --host 0.0.0.0
        </code>
        <p style="margin:0;color:#9b958c;font-size:0.875rem;">
          Luego abre <strong style="color:#ece7df;">https://kultura.tail67f654.ts.net/admin/</strong>
        </p>
      </div>
    </div>
  )}
</body>
</html>